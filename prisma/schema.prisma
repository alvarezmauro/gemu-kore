generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

// UUID defaults use PostgreSQL's introspected spelling; migrations resolve the pg_catalog function.
// Core auth models generated with auth 1.7.7; AccessGrant is application-owned.
// Core catalog/collection: DOMAIN_MODEL.md §10. Deferred features have no placeholder FKs.

model User {
  uploadedAssets        Asset[]               @relation("AssetUploader")
  reviewedAssets        Asset[]               @relation("AssetReviewer")
  approvedCatalogAssets CatalogAsset[]        @relation("CatalogAssetApprover")
  approvedItemMedia     CollectionItemMedia[] @relation("ItemMediaApprover")
  approvedAppAssets     AppAsset[]            @relation("AppAssetApprover")
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  email                 String
  emailVerified         Boolean               @default(false)
  image                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              Session[]
  accounts              Account[]
  createdItems          CollectionItem[]      @relation("ItemCreator")
  updatedItems          CollectionItem[]      @relation("ItemUpdater")
  publishedItems        CollectionItem[]      @relation("ItemPublisher")
  metadataChanges       MetadataChange[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

enum AccessRole {
  ADMIN
  EDITOR
  VIEWER
}

model AccessGrant {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String     @unique
  role      AccessRole
  enabled   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // No User FK: a grant may be provisioned before its holder signs in.
  @@map("access_grant")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum IdentificationStatus {
  INCOMPLETE
  CONFIRMED
}

enum RegionLock {
  UNRESTRICTED
  RESTRICTED
  NOT_APPLICABLE
}

enum GameEditionType {
  STANDARD
  LIMITED
  SPECIAL
  COLLECTORS
  DELUXE
  GREATEST_HITS
  PLAYERS_CHOICE
  PLATINUM
  BUDGET
  RE_RELEASE
  BUNDLE
  CUSTOM
}

enum CompanyCreditRole {
  DEVELOPER
  PORT_DEVELOPER
  PUBLISHER
  DISTRIBUTOR
}

enum ProductIdentifierScheme {
  PRODUCT_CODE
  UPC
  EAN
  OTHER
}

enum CollectionItemType {
  CONSOLE
  GAME
  ACCESSORY
}

enum PublicationStatus {
  PRIVATE
  PUBLISHED
}

enum LocationType {
  PROPERTY
  ROOM
  FURNITURE
  SHELF
  CONTAINER
  CUSTOM
}

enum DefectSeverity {
  COSMETIC
  MINOR
  MAJOR
  CRITICAL
}

enum DefectStatus {
  ACTIVE
  REPAIRED
  ACCEPTED
}

enum MetadataOrigin {
  MANUAL
  SEED
  PROVIDER
  AI_ASSISTED
}

model AppSettings {
  assets                AppAsset[]
  id                    Int             @id @default(1)
  collectionName        String          @default("GemuKore")
  collectionDescription String?
  defaultTheme          ThemePreference @default(SYSTEM)
  timezone              String          @default("UTC")
  preferredCurrency     String?         @db.VarChar(3)
  revision              Int             @default(1)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("app_settings")
}

model PublicSettings {
  id                        Int      @id @default(1)
  publicCollectionEnabled   Boolean  @default(false)
  allowSearchEngineIndexing Boolean  @default(false)
  showSerialNumbers         Boolean  @default(false)
  showLocations             Boolean  @default(false)
  showNotes                 Boolean  @default(false)
  showDefects               Boolean  @default(false)
  showPersonalPhotos        Boolean  @default(false)
  revision                  Int      @default(1)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("public_settings")
}

model Company {
  assets             CatalogAsset[]
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String               @unique
  seedKey            String?              @unique
  archivedAt         DateTime?            @db.Timestamptz(3)
  revision           Int                  @default(1)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  description        String?
  countryCode        String?              @db.VarChar(2)
  foundedYear        Int?
  website            String?
  aliases            String[]             @default([])
  platforms          ConsolePlatform[]
  consoleModels      ConsoleModel[]
  accessories        Accessory[]
  accessoryVariants  AccessoryVariant[]
  gameCredits        GameCompany[]
  releaseCredits     GameReleaseCompany[]
  externalReferences ExternalReference[]
  metadataChanges    MetadataChange[]

  @@map("company")
}

model Region {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String                   @unique
  seedKey           String?                  @unique
  archivedAt        DateTime?                @db.Timestamptz(3)
  revision          Int                      @default(1)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  code              String                   @unique
  description       String?
  consoleModels     ConsoleModelRegion[]
  gameReleases      GameReleaseRegion[]
  accessoryVariants AccessoryVariantRegion[]
  metadataChanges   MetadataChange[]

  @@map("region")
}

model ConsolePlatform {
  assets              CatalogAsset[]
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String                     @unique
  seedKey             String?                    @unique
  archivedAt          DateTime?                  @db.Timestamptz(3)
  revision            Int                        @default(1)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  manufacturerId      String?                    @db.Uuid
  manufacturer        Company?                   @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generation          Int?
  originalReleaseYear Int?
  discontinuedYear    Int?
  description         String?
  history             String?
  aliases             String[]                   @default([])
  models              ConsoleModel[]
  gameReleases        GameRelease[]
  accessoryVariants   AccessoryVariantPlatform[]
  externalReferences  ExternalReference[]
  metadataChanges     MetadataChange[]

  @@index([manufacturerId])
  @@map("console_platform")
}

model ConsoleModel {
  assets               CatalogAsset[]
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String               @unique
  seedKey              String?              @unique
  archivedAt           DateTime?            @db.Timestamptz(3)
  revision             Int                  @default(1)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  platformId           String               @db.Uuid
  platform             ConsolePlatform      @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  manufacturerId       String?              @db.Uuid
  manufacturer         Company?             @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modelNumber          String?
  releaseYear          Int?
  discontinuedYear     Int?
  description          String?
  specifications       Json?
  widthMm              Decimal?             @db.Decimal(10, 3)
  heightMm             Decimal?             @db.Decimal(10, 3)
  depthMm              Decimal?             @db.Decimal(10, 3)
  weightGrams          Decimal?             @db.Decimal(12, 3)
  regionLock           RegionLock?
  regionLockNote       String?
  identificationStatus IdentificationStatus @default(INCOMPLETE)
  regions              ConsoleModelRegion[]
  ownedConsoles        OwnedConsole[]
  identifiers          ProductIdentifier[]
  externalReferences   ExternalReference[]
  metadataChanges      MetadataChange[]

  @@index([platformId])
  @@index([manufacturerId])
  @@index([modelNumber])
  @@map("console_model")
}

model ConsoleModelRegion {
  consoleModelId String       @db.Uuid
  regionId       String       @db.Uuid
  consoleModel   ConsoleModel @relation(fields: [consoleModelId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([consoleModelId, regionId])
  @@index([regionId, consoleModelId])
  @@map("console_model_region")
}

model Game {
  assets             CatalogAsset[]
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String              @unique
  seedKey            String?             @unique
  archivedAt         DateTime?           @db.Timestamptz(3)
  revision           Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  description        String?
  aliases            String[]            @default([])
  releases           GameRelease[]
  companies          GameCompany[]
  externalReferences ExternalReference[]
  metadataChanges    MetadataChange[]

  @@map("game")
}

model GameRelease {
  assets               CatalogAsset[]
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String               @unique
  seedKey              String?              @unique
  archivedAt           DateTime?            @db.Timestamptz(3)
  revision             Int                  @default(1)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  gameId               String               @db.Uuid
  platformId           String               @db.Uuid
  game                 Game                 @relation(fields: [gameId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platform             ConsolePlatform      @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  editionName          String?
  editionType          GameEditionType      @default(STANDARD)
  printingLabel        String?
  firstReleaseYear     Int?
  languages            String[]             @default([])
  descriptionOverride  String?
  metadata             Json?
  regionLock           RegionLock?
  regionLockNote       String?
  identificationStatus IdentificationStatus @default(INCOMPLETE)
  regions              GameReleaseRegion[]
  companies            GameReleaseCompany[]
  ownedGames           OwnedGame[]
  identifiers          ProductIdentifier[]
  externalReferences   ExternalReference[]
  metadataChanges      MetadataChange[]

  @@index([gameId, platformId])
  @@index([platformId])
  @@map("game_release")
}

model GameReleaseRegion {
  gameReleaseId String               @db.Uuid
  regionId      String               @db.Uuid
  releaseYear   Int?
  releaseMonth  Int?
  releaseDay    Int?
  gameRelease   GameRelease          @relation(fields: [gameReleaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  region        Region               @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  companies     GameReleaseCompany[]

  @@id([gameReleaseId, regionId])
  @@index([regionId, gameReleaseId])
  @@map("game_release_region")
}

model GameCompany {
  gameId      String            @db.Uuid
  companyId   String            @db.Uuid
  role        CompanyCreditRole @default(DEVELOPER)
  creditLabel String?
  sortOrder   Int               @default(0)
  game        Game              @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([gameId, companyId, role])
  @@index([companyId, gameId])
  @@map("game_company")
}

model GameReleaseCompany {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameReleaseId String             @db.Uuid
  companyId     String             @db.Uuid
  regionId      String?            @db.Uuid
  role          CompanyCreditRole
  creditLabel   String?
  sortOrder     Int                @default(0)
  gameRelease   GameRelease        @relation(fields: [gameReleaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releaseRegion GameReleaseRegion? @relation(fields: [gameReleaseId, regionId], references: [gameReleaseId, regionId], onDelete: Restrict, onUpdate: Restrict)

  // Scoped/unscoped uniqueness is enforced by partial indexes in migration SQL.
  @@index([gameReleaseId, regionId])
  @@index([companyId, role, gameReleaseId])
  @@map("game_release_company")
}

model Accessory {
  assets             CatalogAsset[]
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String              @unique
  seedKey            String?             @unique
  archivedAt         DateTime?           @db.Timestamptz(3)
  revision           Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  producerId         String?             @db.Uuid
  producer           Company?            @relation(fields: [producerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  description        String?
  releaseYear        Int?
  specifications     Json?
  variants           AccessoryVariant[]
  externalReferences ExternalReference[]
  metadataChanges    MetadataChange[]

  @@index([producerId])
  @@map("accessory")
}

model AccessoryVariant {
  assets                 CatalogAsset[]
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String                     @unique
  seedKey                String?                    @unique
  archivedAt             DateTime?                  @db.Timestamptz(3)
  revision               Int                        @default(1)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  accessoryId            String                     @db.Uuid
  accessory              Accessory                  @relation(fields: [accessoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  producerId             String?                    @db.Uuid
  producer               Company?                   @relation(fields: [producerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modelNumber            String?
  color                  String?
  edition                String?
  releaseYear            Int?
  descriptionOverride    String?
  specificationsOverride Json?
  regionLock             RegionLock?
  regionLockNote         String?
  identificationStatus   IdentificationStatus       @default(INCOMPLETE)
  regions                AccessoryVariantRegion[]
  platforms              AccessoryVariantPlatform[]
  ownedAccessories       OwnedAccessory[]
  identifiers            ProductIdentifier[]
  externalReferences     ExternalReference[]
  metadataChanges        MetadataChange[]

  @@index([accessoryId])
  @@index([producerId])
  @@index([modelNumber])
  @@map("accessory_variant")
}

model AccessoryVariantRegion {
  accessoryVariantId String           @db.Uuid
  regionId           String           @db.Uuid
  accessoryVariant   AccessoryVariant @relation(fields: [accessoryVariantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  region             Region           @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([accessoryVariantId, regionId])
  @@index([regionId, accessoryVariantId])
  @@map("accessory_variant_region")
}

model AccessoryVariantPlatform {
  accessoryVariantId String           @db.Uuid
  platformId         String           @db.Uuid
  compatibilityNote  String?
  accessoryVariant   AccessoryVariant @relation(fields: [accessoryVariantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  platform           ConsolePlatform  @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([accessoryVariantId, platformId])
  @@index([platformId, accessoryVariantId])
  @@map("accessory_variant_platform")
}

model ProductIdentifier {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheme             ProductIdentifierScheme
  value              String
  normalizedValue    String
  issuer             String?
  marketNote         String?
  consoleModelId     String?                 @db.Uuid
  consoleModel       ConsoleModel?           @relation(fields: [consoleModelId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  gameReleaseId      String?                 @db.Uuid
  gameRelease        GameRelease?            @relation(fields: [gameReleaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accessoryVariantId String?                 @db.Uuid
  accessoryVariant   AccessoryVariant?       @relation(fields: [accessoryVariantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([consoleModelId, scheme, normalizedValue])
  @@unique([gameReleaseId, scheme, normalizedValue])
  @@unique([accessoryVariantId, scheme, normalizedValue])
  @@index([scheme, normalizedValue])
  @@map("product_identifier")
}

model ExternalReference {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           String
  providerObjectType String?
  externalId         String?
  url                String?
  normalizedUrl      String?
  metadata           Json?
  companyId          String?           @db.Uuid
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformId         String?           @db.Uuid
  platform           ConsolePlatform?  @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consoleModelId     String?           @db.Uuid
  consoleModel       ConsoleModel?     @relation(fields: [consoleModelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  gameId             String?           @db.Uuid
  game               Game?             @relation(fields: [gameId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  gameReleaseId      String?           @db.Uuid
  gameRelease        GameRelease?      @relation(fields: [gameReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessoryId        String?           @db.Uuid
  accessory          Accessory?        @relation(fields: [accessoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessoryVariantId String?           @db.Uuid
  accessoryVariant   AccessoryVariant? @relation(fields: [accessoryVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([companyId, provider, providerObjectType, externalId])
  @@unique([platformId, provider, providerObjectType, externalId])
  @@unique([consoleModelId, provider, providerObjectType, externalId])
  @@unique([gameId, provider, providerObjectType, externalId])
  @@unique([gameReleaseId, provider, providerObjectType, externalId])
  @@unique([accessoryId, provider, providerObjectType, externalId])
  @@unique([accessoryVariantId, provider, providerObjectType, externalId])
  // URL-only uniqueness is enforced by per-target partial indexes in SQL.
  @@index([provider, providerObjectType, externalId])
  @@map("external_reference")
}

model Location {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  normalizedName String
  parentId       String?          @db.Uuid
  parent         Location?        @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children       Location[]       @relation("LocationHierarchy")
  type           LocationType     @default(CUSTOM)
  description    String?
  sortOrder      Int              @default(0)
  items          CollectionItem[]
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  // Root-name uniqueness is a partial SQL index; NULL is not a sibling ID.
  @@unique([parentId, normalizedName])
  @@index([parentId, sortOrder, id])
  @@map("location")
}

model CollectionItem {
  media             CollectionItemMedia[]
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              CollectionItemType
  serialNumber      String?
  observedMarkings  String?
  locationId        String?               @db.Uuid
  location          Location?             @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hasBox            Boolean?
  notes             String?
  publicationStatus PublicationStatus     @default(PRIVATE)
  publishedAt       DateTime?             @db.Timestamptz(3)
  publishedById     String?               @db.Uuid
  publishedBy       User?                 @relation("ItemPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdById       String?               @db.Uuid
  createdBy         User?                 @relation("ItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?               @db.Uuid
  updatedBy         User?                 @relation("ItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  revision          Int                   @default(1)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  ownedConsole      OwnedConsole?
  ownedGame         OwnedGame?
  ownedAccessory    OwnedAccessory?
  defects           Defect[]

  // Fixed child types + composite FKs + deferred SQL constraint triggers.
  @@unique([id, type])
  @@index([createdAt, id])
  @@index([type, createdAt, id])
  @@index([locationId])
  @@index([createdById])
  @@index([updatedById])
  @@index([publishedById])
  @@map("collection_item")
}

model OwnedConsole {
  collectionItemId String             @id @db.Uuid
  type             CollectionItemType @default(CONSOLE)
  collectionItem   CollectionItem     @relation(fields: [collectionItemId, type], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  consoleModelId   String             @db.Uuid
  consoleModel     ConsoleModel       @relation(fields: [consoleModelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([collectionItemId, type])
  @@index([consoleModelId])
  @@map("owned_console")
}

model OwnedGame {
  collectionItemId String             @id @db.Uuid
  type             CollectionItemType @default(GAME)
  collectionItem   CollectionItem     @relation(fields: [collectionItemId, type], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  gameReleaseId    String             @db.Uuid
  gameRelease      GameRelease        @relation(fields: [gameReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([collectionItemId, type])
  @@index([gameReleaseId])
  @@map("owned_game")
}

model OwnedAccessory {
  collectionItemId   String             @id @db.Uuid
  type               CollectionItemType @default(ACCESSORY)
  collectionItem     CollectionItem     @relation(fields: [collectionItemId, type], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  accessoryVariantId String             @db.Uuid
  accessoryVariant   AccessoryVariant   @relation(fields: [accessoryVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([collectionItemId, type])
  @@index([accessoryVariantId])
  @@map("owned_accessory")
}

model Defect {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionItemId String         @db.Uuid
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  title            String
  description      String?
  severity         DefectSeverity
  status           DefectStatus   @default(ACTIVE)
  resolvedAt       DateTime?      @db.Timestamptz(3)
  repairNote       String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([collectionItemId, status])
  @@map("defect")
}

model MetadataChange {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldPath             String
  before                Json
  after                 Json
  rootRevision          Int
  origin                MetadataOrigin
  sourceSnapshot        Json?
  snapshotSchemaVersion Int               @default(1)
  actorId               String?           @db.Uuid
  actor                 User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  companyId             String?           @db.Uuid
  company               Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  regionId              String?           @db.Uuid
  region                Region?           @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformId            String?           @db.Uuid
  platform              ConsolePlatform?  @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consoleModelId        String?           @db.Uuid
  consoleModel          ConsoleModel?     @relation(fields: [consoleModelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  gameId                String?           @db.Uuid
  game                  Game?             @relation(fields: [gameId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  gameReleaseId         String?           @db.Uuid
  gameRelease           GameRelease?      @relation(fields: [gameReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessoryId           String?           @db.Uuid
  accessory             Accessory?        @relation(fields: [accessoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessoryVariantId    String?           @db.Uuid
  accessoryVariant      AccessoryVariant? @relation(fields: [accessoryVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, rootRevision, fieldPath])
  @@unique([regionId, rootRevision, fieldPath])
  @@unique([platformId, rootRevision, fieldPath])
  @@unique([consoleModelId, rootRevision, fieldPath])
  @@unique([gameId, rootRevision, fieldPath])
  @@unique([gameReleaseId, rootRevision, fieldPath])
  @@unique([accessoryId, rootRevision, fieldPath])
  @@unique([accessoryVariantId, rootRevision, fieldPath])
  @@index([companyId, createdAt, id])
  @@index([regionId, createdAt, id])
  @@index([platformId, createdAt, id])
  @@index([consoleModelId, createdAt, id])
  @@index([gameId, createdAt, id])
  @@index([gameReleaseId, createdAt, id])
  @@index([accessoryId, createdAt, id])
  @@index([accessoryVariantId, createdAt, id])
  @@index([actorId])
  @@map("metadata_change")
}

// Phase 5: logical files, fixed lineage and explicitly approved uses.
enum AssetKind {
  IMAGE
  MODEL_3D
  VIDEO
  DOCUMENT
  OTHER
}

enum AssetScope {
  CATALOG
  COLLECTION
}

enum AssetDeliveryClass {
  ORIGINAL
  DISPLAY
}

enum AssetState {
  PENDING
  READY
  FAILED
  DELETING
}

enum AssetSourceType {
  USER_UPLOAD
  CURATED
  EXTERNAL_PROVIDER
  AI_ASSISTED
  IMPORTED
}

enum AssetRightsStatus {
  UNKNOWN
  APPROVED
  RESTRICTED
}

enum AssetDependencyPurpose {
  RESIZE
  SANITIZE
  RENDER_INPUT
}

enum CatalogAssetRole {
  LOGO
  COVER
  SCREENSHOT
  GALLERY
  MODEL_3D
  VIDEO
  PREVIEW
}

enum CollectionMediaType {
  PHOTO
  FRONT
  BACK
  LEFT
  RIGHT
  TOP
  BOTTOM
  SERIAL
  BOX
  DAMAGE
  OTHER
  CUSTOM_LOGO
  CUSTOM_MODEL
}

enum AppAssetRole {
  COLLECTION_LOGO
}

model Asset {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              AssetKind
  scope             AssetScope
  deliveryClass     AssetDeliveryClass    @default(ORIGINAL)
  state             AssetState            @default(PENDING)
  storageNamespace  String
  objectKey         String
  mimeType          String?
  sizeBytes         BigInt?
  width             Int?
  height            Int?
  durationSeconds   Float?
  originalFilename  String?
  sha256            String?               @db.VarChar(64)
  sourceType        AssetSourceType       @default(USER_UPLOAD)
  provider          String?
  sourceUrl         String?
  author            String?
  licenseName       String?
  licenseUrl        String?
  attribution       String?
  usageRestrictions String?
  retrievedAt       DateTime?             @db.Timestamptz(3)
  rightsStatus      AssetRightsStatus     @default(UNKNOWN)
  publicSafe        Boolean               @default(false)
  reviewedById      String?               @db.Uuid
  reviewedBy        User?                 @relation("AssetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reviewedAt        DateTime?             @db.Timestamptz(3)
  uploadedById      String?               @db.Uuid
  uploadedBy        User?                 @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  metadata          Json?
  transformMetadata Json?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  inputs            AssetDependency[]     @relation("DerivedAsset")
  outputs           AssetDependency[]     @relation("SourceAsset")
  catalogUses       CatalogAsset[]        @relation("CatalogPrivateAsset")
  catalogPublicUses CatalogAsset[]        @relation("CatalogPublicAsset")
  itemUses          CollectionItemMedia[] @relation("ItemPrivateAsset")
  itemPublicUses    CollectionItemMedia[] @relation("ItemPublicAsset")
  appUses           AppAsset[]            @relation("AppPrivateAsset")
  appPublicUses     AppAsset[]            @relation("AppPublicAsset")

  @@unique([storageNamespace, objectKey])
  @@index([sha256])
  @@index([state, createdAt])
  @@index([uploadedById])
  @@index([reviewedById])
  @@map("asset")
}

model AssetDependency {
  derivedAssetId String                 @db.Uuid
  sourceAssetId  String                 @db.Uuid
  purpose        AssetDependencyPurpose
  derivedAsset   Asset                  @relation("DerivedAsset", fields: [derivedAssetId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sourceAsset    Asset                  @relation("SourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([derivedAssetId, sourceAssetId])
  @@index([sourceAssetId, derivedAssetId])
  @@map("asset_dependency")
}

model CatalogAsset {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String?           @db.Uuid
  company              Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  consolePlatformId    String?           @db.Uuid
  consolePlatform      ConsolePlatform?  @relation(fields: [consolePlatformId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  consoleModelId       String?           @db.Uuid
  consoleModel         ConsoleModel?     @relation(fields: [consoleModelId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  gameId               String?           @db.Uuid
  game                 Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  gameReleaseId        String?           @db.Uuid
  gameRelease          GameRelease?      @relation(fields: [gameReleaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accessoryId          String?           @db.Uuid
  accessory            Accessory?        @relation(fields: [accessoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accessoryVariantId   String?           @db.Uuid
  accessoryVariant     AccessoryVariant? @relation(fields: [accessoryVariantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role                 CatalogAssetRole
  isPrimary            Boolean           @default(false)
  caption              String?
  altText              String?
  sortOrder            Int               @default(0)
  assetId              String            @db.Uuid
  asset                Asset             @relation("CatalogPrivateAsset", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicDisplayAssetId String?           @db.Uuid
  publicDisplayAsset   Asset?            @relation("CatalogPublicAsset", fields: [publicDisplayAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicApproved       Boolean           @default(false)
  approvedById         String?           @db.Uuid
  approvedBy           User?             @relation("CatalogAssetApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  approvedAt           DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([assetId])
  @@index([publicDisplayAssetId])
  @@index([approvedById])
  @@index([companyId, role, sortOrder])
  @@index([consolePlatformId, role, sortOrder])
  @@index([consoleModelId, role, sortOrder])
  @@index([gameId, role, sortOrder])
  @@index([gameReleaseId, role, sortOrder])
  @@index([accessoryId, role, sortOrder])
  @@index([accessoryVariantId, role, sortOrder])
  @@map("catalog_asset")
}

model CollectionItemMedia {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionItemId     String              @db.Uuid
  collectionItem       CollectionItem      @relation(fields: [collectionItemId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  type                 CollectionMediaType @default(PHOTO)
  isPrimary            Boolean             @default(false)
  caption              String?
  altText              String?
  sortOrder            Int                 @default(0)
  assetId              String              @db.Uuid
  asset                Asset               @relation("ItemPrivateAsset", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicDisplayAssetId String?             @db.Uuid
  publicDisplayAsset   Asset?              @relation("ItemPublicAsset", fields: [publicDisplayAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicApproved       Boolean             @default(false)
  approvedById         String?             @db.Uuid
  approvedBy           User?               @relation("ItemMediaApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  approvedAt           DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([collectionItemId, sortOrder, id])
  @@index([assetId])
  @@index([publicDisplayAssetId])
  @@index([approvedById])
  @@map("collection_item_media")
}

model AppAsset {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appSettingsId        Int          @default(1)
  appSettings          AppSettings  @relation(fields: [appSettingsId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role                 AppAssetRole @default(COLLECTION_LOGO)
  assetId              String       @db.Uuid
  asset                Asset        @relation("AppPrivateAsset", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicDisplayAssetId String?      @db.Uuid
  publicDisplayAsset   Asset?       @relation("AppPublicAsset", fields: [publicDisplayAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publicApproved       Boolean      @default(false)
  approvedById         String?      @db.Uuid
  approvedBy           User?        @relation("AppAssetApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  approvedAt           DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([appSettingsId, role])
  @@index([assetId])
  @@index([publicDisplayAssetId])
  @@index([approvedById])
  @@map("app_asset")
}
