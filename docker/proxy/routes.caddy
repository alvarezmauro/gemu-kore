(app_routes) {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {http.request.hostport}
		header_up X-Forwarded-Proto https
		flush_interval -1
	}
}
(storage_routes) {
	# Preserve the Host, URI, payload and range headers used in S3 signatures.
	reverse_proxy garage1:3900 garage2:3900 garage3:3900 {
		lb_policy round_robin
		fail_duration 10s
	}
}
