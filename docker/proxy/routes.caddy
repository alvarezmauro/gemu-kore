(app_routes) {
	header Strict-Transport-Security "max-age=31536000"
	# The application is not a tunnel or request-reflection service.
	@unsupported_methods method CONNECT TRACE
	respond @unsupported_methods 405
	@upload path /api/uploads
	@ordinary not path /api/uploads
	request_body @upload {
		max_size 50MiB
	}
	request_body @ordinary {
		max_size 1MiB
	}
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {http.request.hostport}
		header_up X-Forwarded-Proto https
		flush_interval -1
	}
}
(storage_routes) {
	header Strict-Transport-Security "max-age=31536000"
	# Allow S3 framing overhead above the application's 50-MiB object limit.
	request_body {
		max_size 64MiB
	}
	# Only the application's private object transport crosses this edge. Bucket
	# control, multipart and object subresource XML belong to private administration.
	@object_transport {
		method GET HEAD PUT DELETE
		path /{$S3_BUCKET}/assets/*
		vars_regexp object_query {http.request.uri.query} ^(x-id=(GetObject|HeadObject|PutObject|DeleteObject))?$
	}
	handle @object_transport {
		# Preserve signed Host, URI, payload and range headers without rewrites.
		reverse_proxy garage1:3900 garage2:3900 garage3:3900 {
			lb_policy round_robin
			fail_duration 10s
		}
	}
	handle {
		respond 404
	}
}
