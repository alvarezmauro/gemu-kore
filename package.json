{
  "name": "gemu-kore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.28.8"
  },
  "scripts": {
    "dev": "pnpm db:generate && next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.mts",
    "test:storage": "vitest run --config vitest.storage.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:access": "pnpm db:generate && tsx tests/helpers/run-access-browser.ts",
    "test:e2e:critical": "pnpm test:e2e:access --grep @critical",
    "test:e2e:edge": "pnpm test:e2e:access --grep @edge",
    "test:e2e:a11y": "pnpm test:e2e:access --grep @a11y",
    "test:e2e:mobile": "pnpm test:e2e:access --project=mobile-chromium --grep @mobile",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "pnpm db:generate && node --conditions=react-server --import tsx scripts/check-database.ts",
    "access:bootstrap": "pnpm db:generate && node --conditions=react-server --import tsx scripts/access-admin.ts bootstrap",
    "access:recover": "pnpm db:generate && node --conditions=react-server --import tsx scripts/access-admin.ts recover",
    "docker:prepare": "docker volume create gemukore-postgres-data && docker volume create gemukore-minio-data",
    "docker:up": "pnpm docker:prepare && docker compose --env-file .env.local up --build --detach --wait",
    "docker:app": "pnpm docker:prepare && docker compose --env-file .env.local --profile app up --build --detach --wait",
    "docker:down": "docker compose --env-file .env.local --profile app down",
    "docker:status": "docker compose --env-file .env.local --profile app ps",
    "docker:logs": "docker compose --env-file .env.local --profile app logs --follow --tail 100",
    "test:assets": "pnpm db:generate && vitest run --config vitest.assets.config.mts",
    "seed:validate": "tsx scripts/check-console-seeds.ts",
    "three:bundle": "tsx scripts/check-three-bundle.ts",
    "three:fixtures": "tsx scripts/write-three-fixtures.ts",
    "three:report": "tsx scripts/collect-three-performance.ts",
    "three:device": "pnpm db:generate && tsx scripts/serve-three-device.ts",
    "test:production": "node scripts/test-production.mjs",
    "test:backup": "node --test tests/operations/backup.test.mjs",
    "backup:create": "node scripts/backup/production.mjs create",
    "backup:verify": "node scripts/backup/production.mjs verify",
    "backup:restore": "node scripts/backup/production.mjs restore",
    "docker:prod:prepare": "node scripts/prepare-production.mjs",
    "docker:prod:storage": "node scripts/provision-production-storage.mjs",
    "docker:prod:build": "docker compose --env-file .env.production -f docker-compose.production.yml build app migrate",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.production.yml up --detach --wait",
    "docker:prod:status": "docker compose --env-file .env.production -f docker-compose.production.yml ps",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.production.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@hookform/resolvers": "5.9.1",
    "@next/env": "16.4.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
