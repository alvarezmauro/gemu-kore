{
  "name": "gemu-kore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.5.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "pnpm db:generate && node --conditions=react-server --import tsx scripts/check-database.ts",
    "docker:prepare": "docker volume create gemukore-postgres-data && docker volume create gemukore-minio-data",
    "docker:up": "pnpm docker:prepare && docker compose --env-file .env.local up --build --detach --wait",
    "docker:app": "pnpm docker:prepare && docker compose --env-file .env.local --profile app up --build --detach --wait",
    "docker:down": "docker compose --env-file .env.local --profile app down",
    "docker:status": "docker compose --env-file .env.local --profile app ps",
    "docker:logs": "docker compose --env-file .env.local --profile app logs --follow --tail 100"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@next/env": "16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
