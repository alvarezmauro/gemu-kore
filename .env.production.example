# Production only. Copy to .env.production, chmod 600, and fill every required value.
# Keep a distinct release tag for the runtime and operations images of each release.
GEMUKORE_IMAGE=gemukore:production
GEMUKORE_OPERATIONS_IMAGE=gemukore-operations:production
APP_DOMAIN=collection.example.com
STORAGE_DOMAIN=storage.example.com
# Certificate registration contact email.
ACME_EMAIL=
PROXY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
PRODUCTION_VOLUME_PREFIX=gemukore-production
PRODUCTION_PROJECT_NAME=gemukore-production

# Backup destination should be a mounted off-host filesystem for automated runs.
# Keep the mode-600 key file separately, with an offline recovery copy.
BACKUP_DIRECTORY=
BACKUP_KEY_FILE=
BACKUP_KEEP_COUNT=14

POSTGRES_DB=gemukore
# Generate three different URL-safe secrets: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_PASSWORD=

# openssl rand -hex 32; register the exact HTTPS callbacks described in the guide.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The app reaches this hostname through Caddy using verified HTTPS.
S3_ENDPOINT=https://${STORAGE_DOMAIN}
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_BUCKET=gemukore-production
# Garage generates its own application key. Leave these markers for
# pnpm docker:prod:storage, which saves the generated credentials privately.
S3_ACCESS_KEY_ID=PROVISION_WITH_GARAGE
S3_SECRET_ACCESS_KEY=PROVISION_WITH_GARAGE
# GARAGE_RPC_SECRET and GARAGE_ADMIN_TOKEN: separate openssl rand -hex 32 values.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Per replica, in bytes. Three copies share host disk space in this deployment.
GARAGE_NODE_CAPACITY=10737418240

# Optional provider capabilities; leave pairs empty to disable external lookup.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ACCESSORY_METADATA_PROVIDER=none
WIKIDATA_USER_AGENT=
