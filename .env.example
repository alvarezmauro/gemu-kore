# Local development only. Preserve existing .env.local credentials when upgrading.
# Use URL-safe credentials (letters, digits, underscore, hyphen) for the Compose URL.
POSTGRES_USER=gemukore
POSTGRES_DB=gemukore
POSTGRES_PASSWORD=gemukore_local
POSTGRES_PORT=5433
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

MINIO_ROOT_USER=gemukore_admin
MINIO_ROOT_PASSWORD=gemukore_local_storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT="http://127.0.0.1:${MINIO_API_PORT}"
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=gemukore-dev
S3_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
S3_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"

# Optional Docker app; local pnpm dev still uses its own port (normally 3000).
APP_PORT=3002

# Enable either/both OAuth providers by filling each complete credential pair.
# Leave secrets/provider pairs empty to keep sign-in unavailable safely.
# Use the actual browser origin: Docker uses 3002; local dev uses its printed port.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate a random auth secret of at least 32 characters; never use an example secret.
# Register callbacks at ${BETTER_AUTH_URL}/api/auth/callback/google and /github.

# Next.js sets NODE_ENV to development, production, or test; do not override it here.
# Copy this file to .env.local. Database commands require DATABASE_URL.
# Compose uses --env-file .env.local; the app uses postgres/minio service names.
# Storage fields are all-or-none; use HTTPS in production and scoped credentials.
# The adapter is implemented; uploads/Asset records begin in Task 5.3.
# Keep secrets out of NEXT_PUBLIC_* variables and committed files.
